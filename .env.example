# Akahu credentials. Get yours from https://my.akahu.nz/developers
AKAHU_APP_TOKEN=app_token_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AKAHU_USER_TOKEN=user_token_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AKAHU_BASE_URL=https://api.akahu.io/v1

# SAFETY: read-only mode is on by default. Every write tool refuses until false.
AKAHU_READ_ONLY=true

# SAFETY: skip elicit() for automatable writes (account refresh only).
# Requires AKAHU_READ_ONLY=false. Leave false unless you run unattended refresh.
AKAHU_AUTOMATION_BYPASS=false

AKAHU_REQUEST_TIMEOUT=10
AKAHU_LOG_LEVEL=INFO

# --- HTTP proxy (Docker / hosted) ---
# Generate with: uv run nz-akahu-mcp --gen-token
# Then call: https://api-mcp-akahu-proxy.vargr.cc/mcp?token=<this-value>
# Prefer Authorization: Bearer <this-value> when the client supports headers.
MCP_AUTH_TOKEN=
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/mcp

# Optional. Comma-separated Host allow-list (e.g. api-mcp-akahu-proxy.vargr.cc).
# Empty disables the check. Health checks on /healthz skip this.
MCP_ALLOWED_HOSTS=

# Set true only if you run more than one replica behind a load balancer.
MCP_STATELESS=false
